@@ -163,6 +163,23 @@
 option(CITRA_WARNINGS_AS_ERRORS "Enable warnings as errors" ON)
 option(CITRA_ADDRESS_SANITIZE "Enable address sanitizer" OFF)
 option(ENABLE_CCACHE "Use ccache to speed up subsequent builds" OFF)
+option(ROOT_PORT_WEBASSEMBLY_PLATFORM "Build a generic static-CPU software platform" OFF)
+if(ROOT_PORT_WEBASSEMBLY_PLATFORM)
+    if(NOT EMSCRIPTEN OR NOT ARCHITECTURE STREQUAL "GENERIC")
+        message(FATAL_ERROR "The browser platform requires Emscripten and GENERIC architecture")
+    endif()
+    foreach(disallowed IN ITEMS ENABLE_QT ENABLE_SDL2 ENABLE_OPENGL ENABLE_VULKAN ENABLE_OPENAL ENABLE_CUBEB ENABLE_LIBUSB ENABLE_GDBSTUB ENABLE_TESTS ENABLE_ROOM ENABLE_ROOM_STANDALONE ENABLE_WEB_SERVICE ENABLE_SCRIPTING)
+        if(${disallowed})
+            message(FATAL_ERROR "Unsupported browser platform option: ${disallowed}")
+        endif()
+    endforeach()
+    if(NOT ENABLE_SOFTWARE_RENDERER)
+        message(FATAL_ERROR "The browser platform requires software rendering")
+    endif()
+    add_compile_definitions(ROOT_PORT_STATIC_CPU_ONLY=1)
+    add_compile_options(-pthread $<$<COMPILE_LANGUAGE:CXX>:-fwasm-exceptions>)
+    add_link_options(-pthread -fwasm-exceptions)
+endif()
 
