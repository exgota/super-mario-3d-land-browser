+/*
+ * Emscripten platform hooks. The upstream ChaCha implementation and entropy
+ * acquisition remain unchanged. Emscripten has no process fork. Pthreads
+ * share one generator protected by the real pthread mutex below.
+ */
+
+#include <pthread.h>
+#include <stdlib.h>
+
+static pthread_mutex_t arc4random_mtx = PTHREAD_MUTEX_INITIALIZER;
+
+static inline void
+_arc4random_lock(void)
+{
+    if (pthread_mutex_lock(&arc4random_mtx) != 0)
+        abort();
+}
+
+static inline void
+_arc4random_unlock(void)
+{
+    if (pthread_mutex_unlock(&arc4random_mtx) != 0)
+        abort();
+}
+
+#define _ARC4_LOCK() _arc4random_lock()
+#define _ARC4_UNLOCK() _arc4random_unlock()
+
+static inline void
+_getentropy_fail(void)
+{
+    abort();
+}
+
+static inline int
+_rs_allocate(struct _rs **rsp, struct _rsx **rsxp)
+{
+    struct _rs *state = calloc(1, sizeof(*state));
+    if (state == NULL)
+        return -1;
+    struct _rsx *extended_state = calloc(1, sizeof(*extended_state));
+    if (extended_state == NULL) {
+        free(state);
+        return -1;
+    }
+    *rsp = state;
+    *rsxp = extended_state;
+    return 0;
+}
