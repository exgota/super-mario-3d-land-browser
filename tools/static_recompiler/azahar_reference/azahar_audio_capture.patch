diff --git a/src/root_port_capture/audio_capture.cpp b/src/root_port_capture/audio_capture.cpp
new file mode 100644
--- /dev/null
+++ b/src/root_port_capture/audio_capture.cpp
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "root_port_capture/audio_capture.h"
+
+#include <cstdlib>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include "audio_core/audio_types.h"
+#include "root_port_capture/gpu_command_capture.h"
+
+namespace RootPortCapture {
+namespace {
+std::ofstream events;
+std::ofstream payload;
+u64 sequence{};
+u64 sample_frames{};
+constexpr u64 maximum_payload_bytes = 64 * 1024 * 1024;
+}
+
+void InitializeAudio(const std::filesystem::path& output) {
+    sequence = sample_frames = 0;
+    const auto* requested = std::getenv("ROOT_PORT_CAPTURE_AUDIO");
+    if (!requested) return;
+    if (std::string(requested) != "1")
+        throw std::runtime_error("Audio observation accepts only the value 1");
+    const auto event_path = output / "audio_events.jsonl";
+    const auto payload_path = output / "audio_pcm_s16le.bin";
+    if (std::filesystem::exists(event_path) || std::filesystem::exists(payload_path))
+        throw std::runtime_error("Audio observation already exists");
+    events.open(event_path, std::ios::binary);
+    payload.open(payload_path, std::ios::binary);
+    if (!events || !payload) throw std::runtime_error("Cannot create audio observation");
+}
+
+void RecordAudio(std::span<const std::array<s16, 2>> samples, u64 ticks, u64 renderer_frame) {
+    if (!events.is_open() || IsComplete()) return;
+    if (samples.size() != AudioCore::samples_per_frame ||
+        sample_frames * 4 + samples.size() * 4 > maximum_payload_bytes)
+        throw std::runtime_error("Audio observation exceeds its bounded extent");
+    for (const auto& stereo : samples) {
+        for (const s16 sample : stereo) {
+            const auto value = static_cast<u16>(sample);
+            const char bytes[2] = {static_cast<char>(value & 255), static_cast<char>(value >> 8)};
+            payload.write(bytes, sizeof(bytes));
+        }
+    }
+    events << "{\"sequence\":" << sequence++ << ",\"kind\":\"audio_samples\",\"ticks\":" << ticks
+           << ",\"renderer_frame\":" << renderer_frame
+           << ",\"sample_rate\":" << AudioCore::native_sample_rate << ",\"channels\":2"
+           << ",\"sample_frames\":" << samples.size() << ",\"first_sample_frame\":" << sample_frames
+           << ",\"payload_offset\":" << sample_frames * 4 << ",\"payload_bytes\":" << samples.size() * 4
+           << "}\n";
+    sample_frames += samples.size();
+    if (!events || !payload) throw std::runtime_error("Cannot write audio observation");
+}
+
+void FinishAudio(bool complete) {
+    if (!events.is_open()) return;
+    events << "{\"sequence\":" << sequence << ",\"kind\":\"audio_outcome\",\"blocks\":" << sequence
+           << ",\"sample_frames\":" << sample_frames << ",\"payload_bytes\":" << sample_frames * 4
+           << ",\"complete\":" << (complete ? "true" : "false") << "}\n";
+    events.close();
+    payload.close();
+    if (!events || !payload) throw std::runtime_error("Cannot finish audio observation");
+}
+}
