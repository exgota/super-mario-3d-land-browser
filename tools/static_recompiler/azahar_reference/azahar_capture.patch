diff --git a/src/root_port_capture/headless_capture.cpp b/src/root_port_capture/headless_capture.cpp
new file mode 100644
index 0000000..c8eb6b8
--- /dev/null
+++ b/src/root_port_capture/headless_capture.cpp
@@ -0,0 +1,161 @@
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include "audio_core/audio_types.h"
+#include "common/detached_tasks.h"
+#include "common/file_util.h"
+#include "common/logging/backend.h"
+#include "common/logging/filter.h"
+#include "common/settings.h"
+#include "core/core.h"
+#include "core/core_timing.h"
+#include "core/frontend/emu_window.h"
+#include "core/loader/loader.h"
+#include "core/hle/service/service.h"
+#include "root_port_capture/gpu_command_capture.h"
+#include "root_port_capture/headless_capture.h"
+#include "root_port_capture/cpu_backend_factory.h"
+
+namespace {
+class HeadlessCaptureWindow final : public Frontend::EmuWindow {
+public:
+    HeadlessCaptureWindow() = default;
+    ~HeadlessCaptureWindow() override = default;
+    void PollEvents() override {}
+};
+}
+
+int RootPortCapture::RunHeadlessCapture(int argument_count, char** arguments) {
+    if (argument_count < 3 || argument_count > 5) {
+        std::cerr << "usage: azahar_gpu_capture <owned-dump-copy> <absent-output-directory> "
+                     "[input-movie.ctm] [initial-user-directory]\n";
+        return 2;
+    }
+    const auto dump_path = std::filesystem::absolute(arguments[1]);
+    const auto output_path = std::filesystem::absolute(arguments[2]);
+    if (!std::filesystem::is_regular_file(dump_path) || std::filesystem::exists(output_path)) {
+        std::cerr << "dump must exist and output directory must be absent\n";
+        return 2;
+    }
+    std::filesystem::create_directories(output_path);
+    if (argument_count == 5) {
+        const auto initial_user_path = std::filesystem::absolute(arguments[4]);
+        if (!std::filesystem::is_directory(initial_user_path)) {
+            std::cerr << "initial user directory must exist\n";
+            return 2;
+        }
+        std::filesystem::copy(initial_user_path, output_path / "user",
+                              std::filesystem::copy_options::recursive);
+    }
+    FileUtil::SetUserPath(output_path.string() + "/user/");
+    Common::Log::Initialize("reference_capture.log");
+    Common::Log::Filter log_filter;
+    log_filter.ParseFilterString("*:Info");
+    Common::Log::SetGlobalFilter(log_filter);
+    Common::Log::Start();
+    Common::DetachedTasks detached_tasks;
+    Settings::values.use_cpu_jit = true;
+    Settings::values.use_fastinterp = false;
+    Settings::values.deterministic_async_operations = true;
+    Settings::values.async_fs_operations = false;
+    Settings::values.graphics_api = Settings::GraphicsAPI::Software;
+    Settings::values.use_disk_shader_cache = false;
+    Settings::values.disable_right_eye_render = false;
+    Settings::values.frame_limit = 0;
+    Settings::values.audio_emulation = Settings::AudioEmulation::HLE;
+    Settings::values.output_type = AudioCore::SinkType::Null;
+    Settings::values.enable_audio_stretching = false;
+    Settings::values.is_new_3ds = false;
+    Settings::values.plugin_loader_enabled = false;
+    Settings::values.allow_plugin_loader = false;
+    Settings::values.enable_required_online_lle_modules = false;
+    for (const auto& service_module : Service::service_module_map) {
+        Settings::values.lle_modules.emplace(service_module.name, false);
+    }
+    Settings::values.init_clock = Settings::InitClock::FixedTime;
+    Settings::values.init_time = 946684800;
+    auto& system = Core::System::GetInstance();
+    auto& movie = system.Movie();
+    if (argument_count >= 4) {
+        movie.PrepareForPlayback(std::filesystem::absolute(arguments[3]).string());
+    } else {
+        movie.PrepareForRecording();
+    }
+    std::ofstream configuration(output_path / "capture_configuration.json");
+    configuration << "{\"source_commit\":\"662d412123305a9f4be94dd3dc73ddf91a18c55e\","
+                     "\"backend\":\"" << (HasCpuBackendFactory() ? "static recompiler" : "stock Dynarmic")
+                  << "\",\"renderer\":\"software\","
+                     "\"console\":\"old 3DS\",\"audio_sink\":\"null\","
+                     "\"deterministic_async_operations\":true,\"async_fs_operations\":false,"
+                     "\"deterministic_file_read_delay_correction\":true,"
+                     "\"frame_boundary\":\"first top-screen GPU::SetBufferSwap from process load\","
+                     "\"init_time\":" << movie.GetOverrideInitTime()
+                  << ",\"base_ticks\":" << movie.GetOverrideBaseTicks() << "}\n";
+    configuration.close();
+    HeadlessCaptureWindow window;
+    RootPortCapture::Initialize(output_path);
+    Core::System::ResultStatus load_status;
+    try {
+        load_status = system.Load(window, dump_path.string());
+    } catch (const std::exception& exception) {
+        RootPortCapture::Finish("load_exception", 0);
+        std::cerr << "load exception: " << exception.what() << "\n";
+        return 1;
+    }
+    if (load_status != Core::System::ResultStatus::Success) {
+        RootPortCapture::Finish("load_failed", 0);
+        std::cerr << "load failed: " << static_cast<int>(load_status) << "\n";
+        return 1;
+    }
+    std::filesystem::copy(output_path / "user", output_path / "initial_user_state",
+                          std::filesystem::copy_options::recursive);
+    u64 program_id{};
+    system.GetAppLoader().ReadProgramId(program_id);
+    std::ofstream program_manifest(output_path / "program_identity.json");
+    program_manifest << "{\"program_id\":" << program_id << "}\n";
+    program_manifest.close();
+    if (argument_count >= 4) {
+        const auto movie_path = std::filesystem::absolute(arguments[3]).string();
+        if (movie.ValidateMovie(movie_path) != Core::Movie::ValidationResult::OK) {
+            RootPortCapture::Finish("invalid_movie", system.CoreTiming().GetTicks());
+            system.Shutdown();
+            return 1;
+        }
+        movie.SetReadOnly(true);
+        movie.StartPlayback(movie_path);
+    } else {
+        movie.StartRecording((output_path / "input_movie.ctm").string(), "SM3DL root reference");
+    }
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(120);
+    std::string outcome = "wall_time_limit";
+    try {
+        while (!RootPortCapture::IsComplete() && std::chrono::steady_clock::now() < deadline) {
+            const auto status = system.RunLoop(true);
+            if (status != Core::System::ResultStatus::Success) {
+                outcome = "run_failed";
+                break;
+            }
+        }
+        if (RootPortCapture::IsComplete()) {
+            outcome = "first_top_screen_swap";
+        }
+    } catch (const std::exception& exception) {
+        std::cerr << exception.what() << "\n";
+        outcome = "exception";
+    }
+    const bool complete = RootPortCapture::IsComplete();
+    RootPortCapture::Finish(outcome, system.CoreTiming().GetTicks());
+    movie.Shutdown();
+    system.Shutdown();
+    detached_tasks.WaitForAllTasks();
+    std::cout << outcome << "\n";
+    return complete ? 0 : 1;
+}
+
+#ifndef ROOT_PORT_CAPTURE_NO_MAIN
+int main(int argument_count, char** arguments) {
+    return RootPortCapture::RunHeadlessCapture(argument_count, arguments);
+}
+#endif
