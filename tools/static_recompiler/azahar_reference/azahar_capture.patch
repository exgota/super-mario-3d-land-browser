@@ -0,0 +1,28 @@
+#include "root_port_capture/cpu_backend_factory.h"
+
+#include <stdexcept>
+#include <utility>
+
+namespace RootPortCapture {
+namespace {
+CpuBackendFactory backend_factory;
+}
+
+void RegisterCpuBackendFactory(CpuBackendFactory factory) {
+    backend_factory = std::move(factory);
+}
+
+bool HasCpuBackendFactory() {
+    return static_cast<bool>(backend_factory);
+}
+
+std::shared_ptr<Core::ARM_Interface> CreateCpuBackend(
+    Core::System& system, Memory::MemorySystem& memory, u32 core_id,
+    std::shared_ptr<Core::Timing::Timer> timer) {
+    auto backend = backend_factory(system, memory, core_id, std::move(timer));
+    if (!backend) {
+        throw std::runtime_error("Registered CPU backend factory returned no backend");
+    }
+    return backend;
+}
+}
