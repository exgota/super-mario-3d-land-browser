diff --git a/src/root_port_capture/gpu_command_capture.cpp b/src/root_port_capture/gpu_command_capture.cpp
new file mode 100644
index 0000000..05780cf
--- /dev/null
+++ b/src/root_port_capture/gpu_command_capture.cpp
@@ -0,0 +1,153 @@
+#include "root_port_capture/gpu_command_capture.h"
+
+#include <array>
+#include <cstring>
+#include <fstream>
+#include <iomanip>
+#include <sstream>
+#include <stdexcept>
+#include "core/hle/service/gsp/gsp_command.h"
+#include "core/hle/service/gsp/gsp_gpu.h"
+
+namespace RootPortCapture {
+namespace {
+std::filesystem::path output_directory;
+std::ofstream event_stream;
+u64 event_sequence{};
+u64 gsp_command_count{};
+u64 pica_list_count{};
+u64 vblank_count{};
+u64 total_payload_bytes{};
+bool complete{};
+constexpr u64 maximum_payload_bytes = 128 * 1024 * 1024;
+
+void BeginEvent(const char* kind, u64 ticks) {
+    event_stream << "{\"sequence\":" << event_sequence++ << ",\"kind\":\"" << kind
+                 << "\",\"ticks\":" << ticks << ",\"frame\":0";
+}
+
+void EndEvent() {
+    event_stream << "}\n";
+    event_stream.flush();
+    if (!event_stream) {
+        throw std::runtime_error("Cannot write GPU capture event stream");
+    }
+}
+}
+
+void Initialize(const std::filesystem::path& directory) {
+    output_directory = directory;
+    std::filesystem::create_directories(output_directory);
+    event_stream.open(output_directory / "gpu_events.jsonl", std::ios::out | std::ios::trunc);
+    if (!event_stream) {
+        throw std::runtime_error("Cannot open GPU capture event stream");
+    }
+    event_sequence = gsp_command_count = pica_list_count = vblank_count = total_payload_bytes = 0;
+    complete = false;
+}
+
+void RecordGspCommand(const Service::GSP::Command& command, u64 ticks) {
+    if (complete || !event_stream.is_open()) {
+        return;
+    }
+    std::array<u32, sizeof(command) / sizeof(u32)> words{};
+    std::memcpy(words.data(), &command, sizeof(command));
+    BeginEvent("gsp_command", ticks);
+    event_stream << ",\"command_index\":" << gsp_command_count++ << ",\"command_id\":"
+                 << static_cast<u32>(command.id.Value()) << ",\"words\":[";
+    for (std::size_t index = 0; index < words.size(); ++index) {
+        event_stream << (index ? "," : "") << words[index];
+    }
+    event_stream << "]";
+    EndEvent();
+}
+
+void RecordPicaCommandList(PAddr address, const u8* bytes, u32 size, bool chained,
+                           bool ignored, u64 ticks) {
+    if (complete || !event_stream.is_open()) {
+        return;
+    }
+    if (bytes == nullptr || size % sizeof(u32) != 0 ||
+        total_payload_bytes + size > maximum_payload_bytes) {
+        throw std::runtime_error("Invalid or oversized PICA command capture");
+    }
+    std::ostringstream filename;
+    filename << "pica_command_list_" << std::setw(6) << std::setfill('0') << pica_list_count
+             << ".bin";
+    std::ofstream payload(output_directory / filename.str(), std::ios::binary);
+    payload.write(reinterpret_cast<const char*>(bytes), size);
+    payload.close();
+    if (!payload) {
+        throw std::runtime_error("Cannot write PICA command capture");
+    }
+    total_payload_bytes += size;
+    BeginEvent("pica_command_list", ticks);
+    event_stream << ",\"list_index\":" << pica_list_count++ << ",\"physical_address\":"
+                 << address << ",\"size\":" << size << ",\"chained\":"
+                 << (chained ? "true" : "false") << ",\"ignored\":"
+                 << (ignored ? "true" : "false") << ",\"payload\":\"" << filename.str()
+                 << "\",\"gsp_command_index\":" << (gsp_command_count ? gsp_command_count - 1 : 0);
+    EndEvent();
+}
+
+bool RecordBufferSwap(u32 screen_id, const Service::GSP::FrameBufferInfo& info, u64 ticks) {
+    if (complete || !event_stream.is_open()) {
+        return false;
+    }
+    std::array<u32, sizeof(info) / sizeof(u32)> words{};
+    std::memcpy(words.data(), &info, sizeof(info));
+    BeginEvent("buffer_swap", ticks);
+    event_stream << ",\"screen_id\":" << screen_id << ",\"words\":[";
+    for (std::size_t index = 0; index < words.size(); ++index) {
+        event_stream << (index ? "," : "") << words[index];
+    }
+    event_stream << "]";
+    EndEvent();
+    if (screen_id == 0) {
+        complete = true;
+        return true;
+    }
+    return false;
+}
+
+void RecordVBlank(u64 ticks) {
+    if (complete || !event_stream.is_open()) {
+        return;
+    }
+    BeginEvent("vblank", ticks);
+    event_stream << ",\"vblank_index\":" << vblank_count++;
+    EndEvent();
+}
+
+bool IsComplete() {
+    return complete;
+}
+
+void RecordHardwareRegisterWrite(VAddr address, u32 value, u64 ticks) {
+    if (complete || !event_stream.is_open()) {
+        return;
+    }
+    BeginEvent("hardware_register_write", ticks);
+    event_stream << ",\"address\":" << address << ",\"value\":" << value;
+    EndEvent();
+}
+
+void RecordColorFill(u32 value, u64 ticks) {
+    if (complete || !event_stream.is_open()) {
+        return;
+    }
+    BeginEvent("color_fill", ticks);
+    event_stream << ",\"value\":" << value;
+    EndEvent();
+}
+
+void Finish(const std::string& outcome, u64 ticks) {
+    BeginEvent("capture_outcome", ticks);
+    event_stream << ",\"outcome\":\"" << outcome << "\",\"complete\":"
+                 << (complete ? "true" : "false") << ",\"gsp_commands\":" << gsp_command_count
+                 << ",\"pica_lists\":" << pica_list_count << ",\"payload_bytes\":"
+                 << total_payload_bytes << ",\"vblanks\":" << vblank_count;
+    EndEvent();
+    event_stream.close();
+}
+}
