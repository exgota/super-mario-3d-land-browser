diff --git a/src/root_port_capture/CMakeLists.txt b/src/root_port_capture/CMakeLists.txt
--- a/src/root_port_capture/CMakeLists.txt
+++ b/src/root_port_capture/CMakeLists.txt
@@ -11,3 +11,30 @@
     target_link_libraries(citra_core PUBLIC "-framework Foundation" "-framework CoreFoundation"
                                             "-framework CoreGraphics" "-framework AppKit")
 endif()
+
+# Optional strict static ARM backend. Paths point to the clean port checkout and
+# ignored generated headers; neither guest source nor payload enters this tree.
+if(ROOT_PORT_SOURCE_DIRECTORY AND ROOT_PORT_TRANSLATED_DIRECTORY)
+    add_executable(azahar_static_execution
+        ${ROOT_PORT_SOURCE_DIRECTORY}/runtime/port/StaticArmBackend.cpp
+        ${ROOT_PORT_SOURCE_DIRECTORY}/runtime/port/TranslatedFunctionModule.cpp
+        ${ROOT_PORT_SOURCE_DIRECTORY}/runtime/port/GuestMemoryTrace.cpp
+        ${ROOT_PORT_SOURCE_DIRECTORY}/runtime/port/NativeBlockSchedule.cpp
+        ${ROOT_PORT_SOURCE_DIRECTORY}/runtime/port/AzaharStaticExecution.cpp)
+    target_include_directories(azahar_static_execution PRIVATE
+        ${ROOT_PORT_SOURCE_DIRECTORY}/runtime/port ${ROOT_PORT_TRANSLATED_DIRECTORY})
+    target_link_libraries(azahar_static_execution PRIVATE root_port_headless_capture ${CMAKE_DL_LIBS})
+    if(ROOT_PORT_TRANSLATED_LIBRARY_FILE)
+        add_executable(azahar_compiled_execution
+            ${ROOT_PORT_SOURCE_DIRECTORY}/runtime/port/StaticArmBackend.cpp
+            ${ROOT_PORT_SOURCE_DIRECTORY}/runtime/port/TranslatedFunctionModule.cpp
+            ${ROOT_PORT_SOURCE_DIRECTORY}/runtime/port/GuestMemoryTrace.cpp
+            ${ROOT_PORT_SOURCE_DIRECTORY}/runtime/port/NativeBlockSchedule.cpp
+            ${ROOT_PORT_SOURCE_DIRECTORY}/runtime/port/AzaharCompiledExecution.cpp)
+        target_compile_definitions(azahar_compiled_execution PRIVATE ROOT_PORT_STATIC_MODULE_ONLY=1)
+        target_include_directories(azahar_compiled_execution PRIVATE
+            ${ROOT_PORT_SOURCE_DIRECTORY}/runtime/port ${ROOT_PORT_TRANSLATED_DIRECTORY})
+        target_link_libraries(azahar_compiled_execution PRIVATE
+            root_port_headless_capture "${ROOT_PORT_TRANSLATED_LIBRARY_FILE}")
+    endif()
+endif()
