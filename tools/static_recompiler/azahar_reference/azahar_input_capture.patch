diff --git a/src/root_port_capture/input_capture.h b/src/root_port_capture/input_capture.h
new file mode 100644
--- /dev/null
+++ b/src/root_port_capture/input_capture.h
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <filesystem>
+#include "common/common_types.h"
+
+namespace Service::HID {
+struct PadState;
+struct PadDataEntry;
+struct TouchDataEntry;
+}
+
+namespace RootPortCapture {
+void InitializeInput(const std::filesystem::path& output, bool playback);
+bool CapturesInput();
+void ApplyPadInput(Service::HID::PadState& state, s16& x, s16& y, u64 renderer_frame);
+void ApplyTouchInput(Service::HID::TouchDataEntry& state, u64 renderer_frame);
+void RecordDeliveredInput(const Service::HID::PadDataEntry& pad,
+                          const Service::HID::TouchDataEntry& touch,
+                          u32 pad_index, u32 touch_index, u64 renderer_frame, u64 ticks);
+void FinishInput(bool complete);
+}
diff --git a/src/root_port_capture/input_capture.cpp b/src/root_port_capture/input_capture.cpp
new file mode 100644
--- /dev/null
+++ b/src/root_port_capture/input_capture.cpp
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "root_port_capture/input_capture.h"
+
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#include "core/hle/service/hid/hid.h"
+
+namespace RootPortCapture {
+namespace {
+struct InputState {
+    u64 frame{};
+    u32 buttons{};
+    s16 circle_x{}, circle_y{};
+    u16 touch_x{}, touch_y{};
+    bool touched{};
+};
+std::vector<InputState> script;
+std::ofstream stream;
+u64 poll_index{};
+u64 pad_frame{};
+bool awaiting_touch{};
+
+const InputState& StateAt(u64 frame) {
+    std::size_t index = 0;
+    while (index + 1 < script.size() && script[index + 1].frame <= frame) ++index;
+    return script[index];
+}
+}
+
+void InitializeInput(const std::filesystem::path& output, bool playback) {
+    script.clear();
+    poll_index = 0;
+    awaiting_touch = false;
+    const auto* requested = std::getenv("ROOT_PORT_CAPTURE_INPUTS");
+    const auto* script_path = std::getenv("ROOT_PORT_INPUT_SCRIPT");
+    if (requested && std::string(requested) != "1")
+        throw std::runtime_error("Input observation accepts only the value 1");
+    if (script_path && playback)
+        throw std::runtime_error("Script injection is recording-only; playback uses its movie");
+    if (script_path) {
+        if (!*script_path) throw std::runtime_error("Input script path is empty");
+        std::ifstream input(script_path);
+        if (!input) throw std::runtime_error("Cannot read input script");
+        std::string line;
+        while (std::getline(input, line)) {
+            if (line.empty() || line[0] == '#') continue;
+            std::istringstream parser(line);
+            long long frame, buttons, circle_x, circle_y, touch_x, touch_y, touched;
+            std::string trailing;
+            if (!(parser >> frame >> buttons >> circle_x >> circle_y >> touch_x >> touch_y >> touched) ||
+                (parser >> trailing) || frame < 0 || frame > 1000000 || buttons < 0 || buttons > 0xFFF ||
+                circle_x < -154 || circle_x > 154 || circle_y < -154 || circle_y > 154 ||
+                touch_x < 0 || touch_x >= 320 || touch_y < 0 || touch_y >= 240 ||
+                touched < 0 || touched > 1 || script.size() >= 4096 ||
+                (!script.empty() && static_cast<u64>(frame) <= script.back().frame))
+                throw std::runtime_error("Invalid or unordered input script state");
+            script.push_back({static_cast<u64>(frame), static_cast<u32>(buttons),
+                              static_cast<s16>(circle_x), static_cast<s16>(circle_y),
+                              static_cast<u16>(touch_x), static_cast<u16>(touch_y), touched != 0});
+        }
+        if (!input.eof() || script.empty() || script.front().frame != 0)
+            throw std::runtime_error("Input script needs an initial frame 0 state");
+        const auto path = output / "input_script.txt";
+        if (std::filesystem::exists(path)) throw std::runtime_error("Input script receipt already exists");
+        std::ofstream canonical(path, std::ios::binary);
+        for (const auto& value : script)
+            canonical << value.frame << ' ' << value.buttons << ' ' << value.circle_x << ' '
+                      << value.circle_y << ' ' << value.touch_x << ' ' << value.touch_y << ' '
+                      << (value.touched ? 1 : 0) << '\n';
+        canonical.close();
+        if (!canonical) throw std::runtime_error("Cannot write canonical input script receipt");
+    }
+    if (requested || script_path) {
+        const auto path = output / "input_events.jsonl";
+        if (std::filesystem::exists(path)) throw std::runtime_error("Input observation already exists");
+        stream.open(path, std::ios::binary);
+        if (!stream) throw std::runtime_error("Cannot create input observation");
+    }
+}
+
+bool CapturesInput() { return stream.is_open(); }
+
+void ApplyPadInput(Service::HID::PadState& state, s16& x, s16& y, u64 renderer_frame) {
+    if (!CapturesInput()) return;
+    if (awaiting_touch) throw std::runtime_error("Input poll missed its preceding touch channel");
+    pad_frame = renderer_frame;
+    awaiting_touch = true;
+    if (!script.empty()) {
+        const auto& value = StateAt(renderer_frame);
+        state.hex = value.buttons;
+        x = value.circle_x;
+        y = value.circle_y;
+    }
+}
+
+void ApplyTouchInput(Service::HID::TouchDataEntry& state, u64 renderer_frame) {
+    if (!CapturesInput()) return;
+    if (!awaiting_touch || renderer_frame != pad_frame)
+        throw std::runtime_error("Touch channel does not share its pad presentation frame");
+    awaiting_touch = false;
+    if (!script.empty()) {
+        const auto& value = StateAt(renderer_frame);
+        state.x = value.touch_x;
+        state.y = value.touch_y;
+        state.valid.Assign(value.touched ? 1 : 0);
+    }
+}
+
+void RecordDeliveredInput(const Service::HID::PadDataEntry& pad,
+                          const Service::HID::TouchDataEntry& touch,
+                          u32 pad_index, u32 touch_index, u64 renderer_frame, u64 ticks) {
+    if (!CapturesInput()) return;
+    if (awaiting_touch || renderer_frame != pad_frame)
+        throw std::runtime_error("Delivered input has an incomplete or changed poll");
+    stream << "{\"sequence\":" << poll_index++ << ",\"kind\":\"hid_input\",\"ticks\":" << ticks
+           << ",\"renderer_frame\":" << renderer_frame << ",\"pad_index\":" << pad_index
+           << ",\"touch_index\":" << touch_index << ",\"buttons\":" << pad.current_state.hex
+           << ",\"delta_additions\":" << pad.delta_additions.hex
+           << ",\"delta_removals\":" << pad.delta_removals.hex
+           << ",\"circle_pad_x\":" << pad.circle_pad_x << ",\"circle_pad_y\":" << pad.circle_pad_y
+           << ",\"touch_x\":" << touch.x << ",\"touch_y\":" << touch.y
+           << ",\"touch_valid\":" << static_cast<u32>(touch.valid) << "}\n";
+    if (!stream) throw std::runtime_error("Cannot write delivered input observation");
+}
+
+void FinishInput(bool complete) {
+    if (!CapturesInput()) return;
+    stream << "{\"sequence\":" << poll_index << ",\"kind\":\"input_outcome\",\"polls\":" << poll_index
+           << ",\"complete\":" << (complete && !awaiting_touch ? "true" : "false") << "}\n";
+    stream.close();
+    if (!stream) throw std::runtime_error("Cannot finish input observation");
+}
+}
