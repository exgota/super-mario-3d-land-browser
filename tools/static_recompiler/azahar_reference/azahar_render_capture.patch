+
+bool CapturesPresentation() { return presentation_limit != 0; }
+u32 PresentationLimit() { return presentation_limit; }
+
+bool RecordPresentation(const VideoCore::RendererBase& renderer, const Pica::PicaCore& pica,
+                        Memory::MemorySystem& memory, u64 ticks) {
+    if (!presentation_limit || !top_screen_submitted || complete || !event_stream.is_open()) return false;
+    if (++presentation_count < presentation_limit) return false;
+    const auto* software = dynamic_cast<const SwRenderer::RendererSoftware*>(&renderer);
+    if (!software) throw std::runtime_error("Rendering capture requires the software renderer");
+    BeginEvent("frame_presentation", ticks);
+    event_stream << ",\"renderer_frame\":" << renderer.GetCurrentFrame()
+                 << ",\"presentation_index\":" << (presentation_count - 1)
+                 << ",\"submission_ticks\":" << submission_ticks
+                 << ",\"vblank_index\":" << (vblank_count ? vblank_count - 1 : 0)
+                 << ",\"screens\":[";
+    for (const u32 screen_id : {0u, 2u}) {
+        const auto& info = software->Screen(static_cast<VideoCore::ScreenId>(screen_id));
+        const auto& framebuffer = pica.regs.framebuffer_config[screen_id == 2 ? 1 : 0];
+        const auto& fill = screen_id == 2 ? pica.regs_lcd.color_fill_bottom : pica.regs_lcd.color_fill_top;
+        const u32 address = framebuffer.active_fb == 0 ? framebuffer.address_left1 : framebuffer.address_left2;
+        const u32 right_address = framebuffer.active_fb == 0 ? framebuffer.address_right1 : framebuffer.address_right2;
+        const u64 raw_size = u64(framebuffer.stride) * framebuffer.height;
+        const u64 rgba_size = u64(info.width) * info.height * 4;
+        if (info.width == 0 || info.height == 0 || info.width > 4096 || info.height > 4096 ||
+            info.pixels.size() != rgba_size || raw_size == 0 || raw_size > 16 * 1024 * 1024 ||
+            u64(address) + raw_size > std::numeric_limits<u32>::max())
+            throw std::runtime_error("Invalid software presentation or framebuffer extent");
+        const auto* raw = memory.GetPhysicalPointer(address);
+        const auto* last = memory.GetPhysicalPointer(address + static_cast<u32>(raw_size) - 1);
+        if (!raw || last != raw + raw_size - 1)
+            throw std::runtime_error("Framebuffer capture is outside contiguous physical memory");
+        const auto rgba_name = "rendered_screen_" + std::to_string(screen_id) + ".rgba";
+        const auto raw_name = "framebuffer_screen_" + std::to_string(screen_id) + ".bin";
+        const auto write_payload = [&](const std::string& name, const u8* bytes, u64 count) {
+            const auto path = output_directory / name;
+            if (std::filesystem::exists(path)) throw std::runtime_error("Rendering payload already exists");
+            std::ofstream stream(path, std::ios::binary);
+            stream.write(reinterpret_cast<const char*>(bytes), static_cast<std::streamsize>(count));
+            stream.close();
+            if (!stream) throw std::runtime_error("Cannot write rendering payload");
+        };
+        write_payload(rgba_name, info.pixels.data(), rgba_size);
+        write_payload(raw_name, raw, raw_size);
+        event_stream << (screen_id ? "," : "") << "{\"screen_id\":" << screen_id
+                     << ",\"storage_width\":" << info.width << ",\"storage_height\":" << info.height
+                     << ",\"width\":" << info.height << ",\"height\":" << info.width
+                     << ",\"rgba_payload\":\"" << rgba_name << "\",\"rgba_bytes\":" << rgba_size
+                     << ",\"framebuffer_payload\":\"" << raw_name << "\",\"framebuffer_bytes\":" << raw_size
+                     << ",\"framebuffer_width\":" << framebuffer.width
+                     << ",\"framebuffer_height\":" << framebuffer.height
+                     << ",\"stride\":" << framebuffer.stride << ",\"format\":" << framebuffer.format
+                     << ",\"color_format\":" << static_cast<u32>(framebuffer.color_format.Value())
+                     << ",\"active_fb\":" << framebuffer.active_fb
+                     << ",\"physical_address\":" << address << ",\"right_physical_address\":" << right_address
+                     << ",\"color_fill\":" << fill.raw << '}';
+    }
+    event_stream << ']';
+    EndEvent();
+    complete = true;
+    return true;
 }
 
