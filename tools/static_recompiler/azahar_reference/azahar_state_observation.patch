diff --git a/src/root_port_capture/state_capture.cpp b/src/root_port_capture/state_capture.cpp
new file mode 100644
--- /dev/null
+++ b/src/root_port_capture/state_capture.cpp
@@ -0,0 +1,431 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "state_capture.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iomanip>
+#include <limits>
+#include <locale>
+#include <memory>
+#include <optional>
+#include <set>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+#include "core/memory.h"
+
+namespace RootPortCapture {
+namespace {
+constexpr std::size_t MaximumFields = 128;
+constexpr std::size_t MaximumFrames = 1024;
+constexpr std::size_t MaximumOffsets = 16;
+constexpr std::size_t MaximumFieldBytes = 256;
+constexpr std::size_t MaximumNameBytes = 64;
+constexpr std::size_t MaximumPlanBytes = 256 * 1024;
+constexpr u64 MaximumOutputBytes = 16 * 1024 * 1024;
+constexpr u64 OutcomeReserveBytes = 4096;
+constexpr u64 GuestAddressExtent = u64{1} << 32;
+
+struct FieldPlan {
+    std::string name;
+    u32 byte_count{};
+    u32 base_address{};
+    std::vector<u32> offsets;
+};
+
+struct StatePlan {
+    std::vector<u64> frames;
+    std::vector<FieldPlan> fields;
+    std::string canonical;
+};
+
+struct StateCapture {
+    StatePlan plan;
+    std::ofstream events;
+    u64 written_bytes{};
+    u64 sequence{};
+    std::size_t next_frame{};
+    u64 observed_frames{};
+    u64 missing_frames{};
+    u64 unavailable_fields{};
+    bool has_callback{};
+    u64 previous_renderer_frame{};
+    u64 previous_ticks{};
+    u64 previous_vblank_index{};
+};
+
+struct ReadFailure {
+    const char* reason;
+    std::optional<u32> address;
+};
+
+std::unique_ptr<StateCapture> capture;
+
+std::ostringstream JsonStream() {
+    std::ostringstream stream;
+    stream.imbue(std::locale::classic());
+    return stream;
+}
+
+u64 ParseDecimal(const std::string& token, u64 maximum) {
+    if (token.empty()) throw std::runtime_error("State plan decimal is empty");
+    u64 value = 0;
+    for (const char character : token) {
+        if (character < '0' || character > '9')
+            throw std::runtime_error("State plan decimal contains a nondecimal character");
+        const auto digit = static_cast<u64>(character - '0');
+        if (digit > maximum || value > (maximum - digit) / 10)
+            throw std::runtime_error("State plan decimal exceeds its permitted range");
+        value = value * 10 + digit;
+    }
+    return value;
+}
+
+u32 ParseHexadecimal(const std::string& token) {
+    if (token.size() < 3 || token.size() > 10 || token[0] != '0' || token[1] != 'x')
+        throw std::runtime_error("State plan hexadecimal needs 0x and one to eight digits");
+    u32 value = 0;
+    for (std::size_t index = 2; index < token.size(); ++index) {
+        const char character = token[index];
+        u32 digit;
+        if (character >= '0' && character <= '9') digit = character - '0';
+        else if (character >= 'a' && character <= 'f') digit = character - 'a' + 10;
+        else if (character >= 'A' && character <= 'F') digit = character - 'A' + 10;
+        else throw std::runtime_error("State plan hexadecimal contains a nonhexadecimal character");
+        value = value * 16 + digit;
+    }
+    return value;
+}
+
+bool IsFieldName(const std::string& name) {
+    if (name.empty() || name.size() > MaximumNameBytes || name.front() < 'a' || name.front() > 'z' ||
+        name.back() == '_') return false;
+    bool previous_underscore = false;
+    for (const char character : name) {
+        const bool underscore = character == '_';
+        if (!underscore && !(character >= 'a' && character <= 'z') &&
+            !(character >= '0' && character <= '9')) return false;
+        if (underscore && previous_underscore) return false;
+        previous_underscore = underscore;
+    }
+    return true;
+}
+
+std::vector<std::string> SplitLine(const std::string& line) {
+    if (line.empty() || line.front() == ' ' || line.back() == ' ' ||
+        line.find("  ") != std::string::npos)
+        throw std::runtime_error("State plan lines need single spaces and nonempty tokens");
+    for (const unsigned char character : line)
+        if (character < 0x20 || character > 0x7e)
+            throw std::runtime_error("State plan uses only printable ASCII and LF lines");
+    std::vector<std::string> tokens;
+    std::istringstream stream(line);
+    stream.imbue(std::locale::classic());
+    for (std::string token; stream >> token;) tokens.push_back(std::move(token));
+    return tokens;
+}
+
+std::string HexadecimalAddress(u32 address) {
+    auto stream = JsonStream();
+    stream << "0x" << std::hex << std::setfill('0') << std::setw(8) << address;
+    return stream.str();
+}
+
+std::string HexadecimalBytes(const u8* bytes, std::size_t count) {
+    constexpr char digits[] = "0123456789abcdef";
+    std::string result;
+    result.reserve(count * 2);
+    for (std::size_t index = 0; index < count; ++index) {
+        result.push_back(digits[bytes[index] >> 4]);
+        result.push_back(digits[bytes[index] & 15]);
+    }
+    return result;
+}
+
+StatePlan ReadPlan(const std::filesystem::path& path) {
+    if (std::filesystem::is_symlink(std::filesystem::symlink_status(path)) ||
+        !std::filesystem::is_regular_file(path))
+        throw std::runtime_error("State plan must be an ordinary existing file");
+    const auto file_bytes = std::filesystem::file_size(path);
+    if (file_bytes == 0 || file_bytes > MaximumPlanBytes)
+        throw std::runtime_error("State plan exceeds its bounded input extent");
+    std::ifstream input(path, std::ios::binary);
+    if (!input) throw std::runtime_error("Cannot open state plan");
+    std::string raw(static_cast<std::size_t>(file_bytes), '\0');
+    input.read(raw.data(), static_cast<std::streamsize>(raw.size()));
+    if (input.gcount() != static_cast<std::streamsize>(raw.size()) ||
+        input.get() != std::char_traits<char>::eof() || input.bad() || raw.back() != '\n')
+        throw std::runtime_error("State plan must have a stable bounded extent and final LF");
+    std::istringstream lines(raw);
+    std::string line;
+    if (!std::getline(lines, line) || line != "version 1")
+        throw std::runtime_error("State plan needs version 1 on its first line");
+    if (!std::getline(lines, line)) throw std::runtime_error("State plan has no frames line");
+    const auto frame_tokens = SplitLine(line);
+    if (frame_tokens.front() != "frames" || frame_tokens.size() < 2 ||
+        frame_tokens.size() > MaximumFrames + 1)
+        throw std::runtime_error("State plan needs one to 1024 requested frames");
+    StatePlan plan;
+    for (std::size_t index = 1; index < frame_tokens.size(); ++index) {
+        const u64 frame = ParseDecimal(frame_tokens[index], std::numeric_limits<u64>::max());
+        if (!plan.frames.empty() && frame <= plan.frames.back())
+            throw std::runtime_error("State plan frames must increase strictly");
+        plan.frames.push_back(frame);
+    }
+    std::set<std::string> names;
+    while (std::getline(lines, line)) {
+        const auto tokens = SplitLine(line);
+        if (tokens.front() != "field" || tokens.size() < 5 || tokens.size() > MaximumOffsets + 4 ||
+            plan.fields.size() >= MaximumFields)
+            throw std::runtime_error("State plan field count or pointer chain is invalid");
+        if (!IsFieldName(tokens[1]) || !names.insert(tokens[1]).second)
+            throw std::runtime_error("State plan names need unique bounded lower snake_case");
+        FieldPlan field;
+        field.name = tokens[1];
+        field.byte_count = static_cast<u32>(ParseDecimal(tokens[2], MaximumFieldBytes));
+        if (field.byte_count == 0) throw std::runtime_error("State field byte count must be positive");
+        field.base_address = ParseHexadecimal(tokens[3]);
+        for (std::size_t index = 4; index < tokens.size(); ++index)
+            field.offsets.push_back(ParseHexadecimal(tokens[index]));
+        const u64 first_address = static_cast<u64>(field.base_address) + field.offsets.front();
+        const u64 first_extent = field.offsets.size() == 1 ? field.byte_count : sizeof(u32);
+        if (first_address >= GuestAddressExtent || first_extent > GuestAddressExtent - first_address)
+            throw std::runtime_error("State field initial read exceeds the 32-bit guest address space");
+        plan.fields.push_back(std::move(field));
+    }
+    if (plan.fields.empty()) throw std::runtime_error("State plan needs at least one field");
+    auto canonical = JsonStream();
+    canonical << "version 1\nframes";
+    for (const u64 frame : plan.frames) canonical << ' ' << frame;
+    canonical << '\n';
+    for (const auto& field : plan.fields) {
+        canonical << "field " << field.name << ' ' << field.byte_count << ' '
+                  << HexadecimalAddress(field.base_address);
+        for (const u32 offset : field.offsets) canonical << ' ' << HexadecimalAddress(offset);
+        canonical << '\n';
+    }
+    plan.canonical = canonical.str();
+    // Conservative JSON bound: every pointer trace, unavailable field, frame and footer fits.
+    u64 maximum_frame_bytes = 512;
+    for (const auto& field : plan.fields)
+        maximum_frame_bytes += 512 + field.name.size() + 2 * field.byte_count +
+                               256 * (field.offsets.size() - 1);
+    const u64 maximum_output = plan.canonical.size() +
+                              maximum_frame_bytes * plan.frames.size() + OutcomeReserveBytes;
+    if (maximum_output > MaximumOutputBytes)
+        throw std::runtime_error("State plan worst-case output exceeds 16 MiB");
+    return plan;
+}
+
+void Emit(const std::string& event, bool outcome = false) {
+    const u64 count = event.size() + 1;
+    const u64 limit = MaximumOutputBytes - (outcome ? 0 : OutcomeReserveBytes);
+    if (capture->written_bytes > limit || count > limit - capture->written_bytes)
+        throw std::runtime_error("State observation exceeds its output bound");
+    capture->events << event << '\n';
+    if (!capture->events) throw std::runtime_error("Cannot write state observation");
+    capture->written_bytes += count;
+    ++capture->sequence;
+}
+
+void EmitMissingFrame(u64 requested, const char* reason, std::optional<u64> frame,
+                      std::optional<u64> ticks, std::optional<u64> vblank_index) {
+    auto event = JsonStream();
+    event << "{\"sequence\":" << capture->sequence << ",\"kind\":\"state_frame_unavailable\","
+          << "\"requested_renderer_frame\":" << requested << ",\"renderer_frame\":";
+    if (frame) event << *frame; else event << "null";
+    event << ",\"ticks\":";
+    if (ticks) event << *ticks; else event << "null";
+    event << ",\"vblank_index\":";
+    if (vblank_index) event << *vblank_index; else event << "null";
+    event << ",\"reason\":\"" << reason << "\"}";
+    Emit(event.str());
+    ++capture->missing_frames;
+}
+
+std::optional<ReadFailure> ReadOrdinaryMemory(Memory::PageTable* page_table, u32 address,
+                                            std::size_t count, u8* bytes) {
+    if (address == 0) return ReadFailure{"null_address", address};
+    if (count > GuestAddressExtent - static_cast<u64>(address))
+        return ReadFailure{"address_overflow", address};
+    if (!page_table) return ReadFailure{"page_table_unavailable", address};
+    auto& pointers = page_table->GetPointerArray();
+    // Validate the entire range before copying any bytes. Never invoke memory fallbacks.
+    for (std::size_t copied = 0; copied < count;) {
+        const u32 current = static_cast<u32>(static_cast<u64>(address) + copied);
+        const std::size_t page = current >> Memory::CITRA_PAGE_BITS;
+        if (page_table->attributes[page] != Memory::PageType::Memory)
+            return ReadFailure{"page_not_ordinary_memory", current};
+        if (!pointers[page]) return ReadFailure{"page_pointer_unavailable", current};
+        copied += std::min<std::size_t>(count - copied,
+                                      Memory::CITRA_PAGE_SIZE - (current & Memory::CITRA_PAGE_MASK));
+    }
+    for (std::size_t copied = 0; copied < count;) {
+        const u32 current = static_cast<u32>(static_cast<u64>(address) + copied);
+        const std::size_t page = current >> Memory::CITRA_PAGE_BITS;
+        const std::size_t offset = current & Memory::CITRA_PAGE_MASK;
+        const std::size_t chunk = std::min<std::size_t>(count - copied, Memory::CITRA_PAGE_SIZE - offset);
+        std::memcpy(bytes + copied, pointers[page] + offset, chunk);
+        copied += chunk;
+    }
+    return std::nullopt;
+}
+
+std::string ObserveField(Memory::PageTable* page_table, const FieldPlan& field) {
+    auto traces = JsonStream();
+    u32 current_address = field.base_address;
+    std::optional<ReadFailure> failure;
+    std::optional<u32> final_address;
+    std::array<u8, MaximumFieldBytes> bytes{};
+    if (current_address == 0) failure = ReadFailure{"null_address", current_address};
+    for (std::size_t index = 0; !failure && index < field.offsets.size(); ++index) {
+        const u64 sum = static_cast<u64>(current_address) + field.offsets[index];
+        const bool final = index + 1 == field.offsets.size();
+        if (sum >= GuestAddressExtent) {
+            failure = ReadFailure{"address_overflow", std::nullopt};
+            if (!final) {
+                if (index) traces << ',';
+                traces << "{\"offset\":" << field.offsets[index] << ",\"read_address\":null,"
+                       << "\"status\":\"unavailable\",\"reason\":\"address_overflow\"}";
+            }
+            break;
+        }
+        const u32 address = static_cast<u32>(sum);
+        if (final) {
+            final_address = address;
+            failure = ReadOrdinaryMemory(page_table, address, field.byte_count, bytes.data());
+        } else {
+            std::array<u8, sizeof(u32)> pointer_bytes{};
+            failure = ReadOrdinaryMemory(page_table, address, pointer_bytes.size(), pointer_bytes.data());
+            if (index) traces << ',';
+            traces << "{\"offset\":" << field.offsets[index] << ",\"read_address\":" << address;
+            if (failure) {
+                traces << ",\"status\":\"unavailable\",\"reason\":\"" << failure->reason
+                       << "\",\"failure_address\":";
+                if (failure->address) traces << *failure->address; else traces << "null";
+            } else {
+                current_address = static_cast<u32>(pointer_bytes[0]) |
+                                  (static_cast<u32>(pointer_bytes[1]) << 8) |
+                                  (static_cast<u32>(pointer_bytes[2]) << 16) |
+                                  (static_cast<u32>(pointer_bytes[3]) << 24);
+                traces << ",\"status\":\"available\",\"value\":" << current_address
+                       << ",\"bytes\":\"" << HexadecimalBytes(pointer_bytes.data(), pointer_bytes.size()) << '"';
+                if (current_address == 0) failure = ReadFailure{"null_pointer", address};
+            }
+            traces << '}';
+        }
+    }
+    auto result = JsonStream();
+    result << "{\"name\":\"" << field.name << "\",\"byte_count\":" << field.byte_count
+           << ",\"base_address\":" << field.base_address << ",\"address\":";
+    if (final_address) result << *final_address; else result << "null";
+    result << ",\"status\":\"" << (failure ? "unavailable" : "available") << "\",\"bytes\":";
+    if (failure) {
+        result << "null,\"reason\":\"" << failure->reason << "\",\"failure_address\":";
+        if (failure->address) result << *failure->address; else result << "null";
+        ++capture->unavailable_fields;
+    } else {
+        result << '"' << HexadecimalBytes(bytes.data(), field.byte_count) << '"';
+    }
+    result << ",\"pointer_reads\":[" << traces.str() << "]}";
+    return result.str();
+}
+
+void RequireAbsent(const std::filesystem::path& path) {
+    if (std::filesystem::exists(path) || std::filesystem::is_symlink(std::filesystem::symlink_status(path)))
+        throw std::runtime_error("State observation output must be absent");
+}
+}
+
+void InitializeState(const std::filesystem::path& output) {
+    const char* requested = std::getenv("ROOT_PORT_STATE_PLAN");
+    if (!requested) return;
+    if (capture) throw std::runtime_error("State observation is already initialized");
+    if (!*requested) throw std::runtime_error("State plan path is empty");
+    auto proposed = std::make_unique<StateCapture>();
+    proposed->plan = ReadPlan(std::filesystem::absolute(requested));
+    if (std::filesystem::is_symlink(std::filesystem::symlink_status(output)) ||
+        !std::filesystem::is_directory(output))
+        throw std::runtime_error("State observation output needs an ordinary existing directory");
+    const auto directory = std::filesystem::canonical(output);
+    const auto receipt_path = directory / "state_plan.txt";
+    const auto event_path = directory / "state_events.jsonl";
+    RequireAbsent(receipt_path);
+    RequireAbsent(event_path);
+    // All grammar, static ranges, total bounds and paths are checked before creating either file.
+    std::ofstream receipt(receipt_path, std::ios::binary);
+    if (!receipt) throw std::runtime_error("Cannot create state plan receipt");
+    receipt << proposed->plan.canonical;
+    receipt.close();
+    if (!receipt) throw std::runtime_error("Cannot finish state plan receipt");
+    proposed->events.open(event_path, std::ios::binary);
+    proposed->events.imbue(std::locale::classic());
+    if (!proposed->events) throw std::runtime_error("Cannot create state observation");
+    proposed->written_bytes = proposed->plan.canonical.size();
+    capture = std::move(proposed);
+}
+
+void RecordState(Memory::MemorySystem& memory, u64 renderer_frame, u64 ticks, u64 vblank_index) {
+    if (!capture) return;
+    if (capture->has_callback && (renderer_frame < capture->previous_renderer_frame ||
+        ticks < capture->previous_ticks || vblank_index < capture->previous_vblank_index))
+        throw std::runtime_error("State observation callback metadata moved backwards");
+    capture->has_callback = true;
+    capture->previous_renderer_frame = renderer_frame;
+    capture->previous_ticks = ticks;
+    capture->previous_vblank_index = vblank_index;
+    while (capture->next_frame < capture->plan.frames.size() &&
+           capture->plan.frames[capture->next_frame] < renderer_frame) {
+        EmitMissingFrame(capture->plan.frames[capture->next_frame], "frame_not_observed",
+                         renderer_frame, ticks, vblank_index);
+        ++capture->next_frame;
+    }
+    if (capture->next_frame == capture->plan.frames.size() ||
+        capture->plan.frames[capture->next_frame] != renderer_frame) return;
+    const auto page_table = memory.GetCurrentPageTable();
+    auto event = JsonStream();
+    event << "{\"sequence\":" << capture->sequence << ",\"kind\":\"state_observation\","
+          << "\"renderer_frame\":" << renderer_frame << ",\"ticks\":" << ticks
+          << ",\"vblank_index\":" << vblank_index << ",\"fields\":[";
+    for (std::size_t index = 0; index < capture->plan.fields.size(); ++index) {
+        if (index) event << ',';
+        event << ObserveField(page_table.get(), capture->plan.fields[index]);
+    }
+    event << "]}";
+    Emit(event.str());
+    ++capture->observed_frames;
+    ++capture->next_frame;
+}
+
+void FinishState(bool complete) {
+    if (!capture) return;
+    while (capture->next_frame < capture->plan.frames.size()) {
+        EmitMissingFrame(capture->plan.frames[capture->next_frame], "capture_ended_before_frame",
+                         std::nullopt, std::nullopt, std::nullopt);
+        ++capture->next_frame;
+    }
+    const bool frames_complete = capture->observed_frames == capture->plan.frames.size();
+    const bool fields_complete = capture->observed_frames != 0 && capture->unavailable_fields == 0;
+    auto outcome = JsonStream();
+    outcome << "{\"sequence\":" << capture->sequence << ",\"kind\":\"state_outcome\","
+            << "\"requested_frames\":" << capture->plan.frames.size()
+            << ",\"fields_per_frame\":" << capture->plan.fields.size()
+            << ",\"observed_frames\":" << capture->observed_frames
+            << ",\"missing_frames\":" << capture->missing_frames
+            << ",\"observed_fields\":" << capture->observed_frames * capture->plan.fields.size()
+            << ",\"unavailable_fields\":" << capture->unavailable_fields
+            << ",\"capture_complete\":" << (complete ? "true" : "false")
+            << ",\"all_requested_frames_observed\":" << (frames_complete ? "true" : "false")
+            << ",\"all_observed_fields_available\":" << (fields_complete ? "true" : "false")
+            << ",\"complete\":" << (complete && frames_complete && fields_complete ? "true" : "false") << '}';
+    Emit(outcome.str(), true);
+    capture->events.close();
+    if (!capture->events) throw std::runtime_error("Cannot finish state observation");
+    capture.reset();
+}
+}
